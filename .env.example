# Copy to .env on the VM and fill in real values (never commit .env).
# Names map to backend/api/src/openwellness_api/config.py.

# Storage backend switch — selects which persistence backend the API and
# scheduler use. Defaults to couchbase-mongo (the settings below). Setting
# this to `postgres` requires POSTGRES_URL; no Postgres driver exists yet
# as of this phase, so this value is not wired to any repository.
STORAGE_BACKEND=couchbase-mongo

# Couchbase — external instance reachable via outbound access.
COUCHBASE_URL=
COUCHBASE_USERNAME=
COUCHBASE_PASSWORD=
COUCHBASE_BUCKET_NAME=

# Mongo — opserver publishes it on the VM host; reach it via host.docker.internal.
# The app user authenticates against the app DB itself, so authSource = <db> (NOT admin).
MONGO_URL=mongodb://<user>:<pass>@host.docker.internal:27017/?authSource=<db>
MONGO_DB=<db>

# Sync Gateway.
# When running the local integration-test harness (see below), point this at
# http://localhost:4984/spring — the public interface of the harness Sync
# Gateway, path-suffixed with the database name.
SYNC_GATEWAY_URL=

# Sync Gateway + Couchbase test harness — LOCAL INTEGRATION TESTS ONLY.
# These drive the `couchbase`, `couchbase-init` and `sync-gateway` services in
# docker-compose.yml, which exist to reproduce production Sync Gateway
# behavior faithfully enough that an integration test proves something. They
# are not used by any deployed environment.
#
# The bucket and the Sync Gateway database are BOTH named `spring`, and the
# Couchbase user Sync Gateway authenticates as is `sgw`, because that is
# exactly what production does. Do not "tidy" these names — fidelity to
# production is the reason the harness exists.
#
# Bring the harness up with:
#   ./scripts/render_sync_gateway_config.sh
#   docker compose up -d couchbase couchbase-init sync-gateway
COUCHBASE_ADMIN_USER=Administrator
COUCHBASE_ADMIN_PASSWORD=
SYNC_GATEWAY_CB_USER=sgw
SYNC_GATEWAY_CB_PASSWORD=
SYNC_GATEWAY_DB=spring
# Unauthenticated admin interface — loopback-published only, never exposed.
SYNC_GATEWAY_ADMIN_URL=http://localhost:4985

# Postgres — only required when STORAGE_BACKEND=postgres. No Postgres
# driver exists yet as of this phase; these are only read for the
# fail-fast startup check.
POSTGRES_URL=
POSTGRES_POOL_SIZE=5

# API metadata.
API_TITLE=OpenWellness API

# Default App-entity identifiers stamped by AppRepository.create_app
# (unlisted-link apps). Deployment-specific; leave empty to skip.
APP_STORE_ID=
APP_IOS_BUNDLE_ID=
APP_ONE_SIGNAL_APP_ID=

# Celery (scheduler) — broker + result backend. Defaults assume the redis
# service in docker-compose; names map to backend/scheduler/.../config.py.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
